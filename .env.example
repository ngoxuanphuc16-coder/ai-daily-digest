# ---------------------------------------------------------------------------
# AI Daily Digest — copy to `.env` and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Gemini (required for AI summaries) ------------------------------------
# Get a key at https://aistudio.google.com/app/apikey
# Without it the pipeline still runs, but falls back to extractive summaries.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- SMTP delivery (required unless you only use --dry-run) ----------------
# Gmail: use an App Password (16 chars), NOT your account password.
# https://myaccount.google.com/apppasswords  (requires 2-Step Verification)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SENDER_EMAIL=you@gmail.com
SENDER_PASSWORD=your-16-char-app-password
# Comma-separated for multiple recipients.
RECEIVER_EMAIL=you@gmail.com

# Optional: display name on the From: header.
SENDER_NAME=AI Daily Digest

# --- Pipeline tuning (all optional) ----------------------------------------
# Only collect articles published within this many hours.
LOOKBACK_HOURS=24
# Hard cap on articles that reach the summarizer (cost control).
MAX_ARTICLES=10
# Parallel Gemini calls. Lower this if you hit rate limits.
SUMMARY_WORKERS=4
# Retries per article before falling back to the extractive summarizer.
SUMMARY_MAX_RETRIES=3
# Gemini requests per minute. The FREE tier allows 5 for gemini-2.5-flash;
# exceeding it returns 429. At 5 rpm, 25 articles take about 5 minutes.
GEMINI_RPM=5
# Send the email even when zero articles were found. Default: false.
SEND_WHEN_EMPTY=false
